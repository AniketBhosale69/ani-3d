# Cloudflare Pages header rules.
# https://developers.cloudflare.com/pages/configuration/headers/
#
# Rule of thumb used here: assets whose filename never changes when their
# contents change (style.css, script.js, the HTML pages) must NOT be cached
# long, or visitors will keep seeing a stale site after a deploy. Images and
# favicons are effectively immutable once uploaded, so they get a long TTL.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# HTML: always revalidate so deploys go live immediately.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

# CSS/JS are not content-hashed, so they follow the same rule as HTML.
/style.css
  Cache-Control: public, max-age=0, must-revalidate

/script.js
  Cache-Control: public, max-age=0, must-revalidate

# Static media: safe to cache hard. Rename the file if you ever replace one.
/images/*
  Cache-Control: public, max-age=31536000, immutable

/favicon_io/*
  Cache-Control: public, max-age=31536000, immutable

# Admin panel: never cached, never indexed.
/admin/*
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow

# API responses set their own Cache-Control; just keep them out of search.
/api/*
  X-Robots-Tag: noindex, nofollow

# Crawler files: short cache so sitemap edits propagate.
/sitemap.xml
  Cache-Control: public, max-age=3600

/robots.txt
  Cache-Control: public, max-age=3600

/site.webmanifest
  Cache-Control: public, max-age=3600
